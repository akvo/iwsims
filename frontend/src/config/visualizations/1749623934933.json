    {
      "id": "chart_drinking_water_compliance",
      "info": "[Construction monitoring]\nif all true: Compliant\nIf one of false: Non_compliant\nIf one of empty: No_information available\n\n=IF([@Water test conducted?]<>\"Lab-tested\", \"N/A\",\n  IF(OR(\n    [@Number of E-coli for the Lab]>0,\n    [@What is the Turbidity in NTU?]>5,\n    [@What is the Total Coliform Level?]>0,\n    [@What is the Fecal Coliform Level?]>0,\n    [@Temperature °C - 2550B (APHA Method Code)]>30,\n    [@pH - 4500-H+B (APHA Method Code)]<6.5, [@pH - 4500-H+B (APHA Method Code)]>8.5,\n    [@Conductivity µS/cm - 2510B (APHA Method Code)]>1000,\n    [@Salinity PPT 2520B 0.2 (APHA Method Code)]>1,\n    AND([@Water test conducted?]<>\"CBT-bag\", [@Level of Contamination using CBT bags?]>0)\n  ), \"Non-Compliant\",\n  IF(OR(\n    ISBLANK([@Number of E-coli for the Lab]),\n    ISBLANK([@What is the Turbidity in NTU?]),\n    ISBLANK([@What is the Total Coliform Level?]),\n    ISBLANK([@What is the Fecal Coliform Level?]),\n    ISBLANK([@Temperature °C - 2550B (APHA Method Code)]),\n    ISBLANK([@pH - 4500-H+B (APHA Method Code)]),\n    ISBLANK([@Conductivity µS/cm - 2510B (APHA Method Code)]),\n    ISBLANK([@Salinity PPT 2520B 0.2 (APHA Method Code)]),\n    AND([@Water test conducted?]<>\"CBT-bag\", ISBLANK([@Level of Contamination using CBT bags?]))\n  ), \"No Information Available\",\n  \"Compliant\")))\n\n[Water quality monitoring]\nif all true: Compliant\nIf one of false: Non_compliant\nIf one of empty: No_information available\n\n=IF([@Method of Water Testing Used?]<>\"Lab-tested\", \"N/A\",\n  IF(OR(\n    [@Number of E. coli for the Lab Test]>0,\n    [@What is the Turbidity in NTU?]>5,\n    [@What is the Total Coliform count in 1cfu/100ml?]>0,\n    [@What is the Fecal Coliform count in 1cfu/100ml?]>0,\n    [@Temperature °C - 2550B (APHA Method Code)]>30,\n    [@pH - 4500-H+B (APHA Method Code)]<6.5, [@pH - 4500-H+B (APHA Method Code)]>8.5,\n    [@Conductivity µS/cm - 2510B (APHA Method Code)]>1000,\n    [@Salinity PPT 2520B 0.2 (APHA Method Code)]>1,\n    AND([@174963301462]<>\"CBT-bag\", [@What is the E. coli Count using CBT Bags?]>0)\n  ), \"Non-Compliant\",\n  IF(OR(\n    ISBLANK([@Number of E. coli for the Lab Test]),\n    ISBLANK([@What is the Turbidity in NTU?]),\n    ISBLANK([@What is the Total Coliform count in 1cfu/100ml?]),\n    ISBLANK([@What is the Fecal Coliform count in 1cfu/100ml?]),\n    ISBLANK([@Temperature °C - 2550B (APHA Method Code)]),\n    ISBLANK([@pH - 4500-H+B (APHA Method Code)]),\n    ISBLANK([@Conductivity µS/cm - 2510B (APHA Method Code)]),\n    ISBLANK([@Salinity PPT 2520B 0.2 (APHA Method Code)]),\n    AND([@174963301462]<>\"CBT-bag\", ISBLANK([@What is the E. coli Count using CBT Bags?]))\n  ), \"No Information Available\",\n  \"Compliant\")))",
      "chart_type": "stack_bar",
      "order": 11,
      "col_span": 12,
      "config": {
        "title": "Drinking Water Compliance",
        "xAxisLabel": "Compliant",
        "yAxisLabel": "EPS count"
      },
      "color_map": {
        "Compliant": "#2e7d32",
        "E-coli presence": "#c62828",
        "Turbidity": "#ef6c00",
        "Total coliform presence": "#6a1b9a",
        "Fecal coliform presence": "#1565c0",
        "Water Temperature": "#8d4e24",
        "pH": "#d81b60",
        "Conductivity": "#00838f",
        "Salinity": "#9e7c00",
        "E-coli CBT": "#7c4dff",
        "No information available": "#90a4ae",
        "N/A": "#263238"
      },
