              "info": "IFERROR(\n  SUMPRODUCT(\n    -- Concrete Base Construction\n    IF(ISNUMBER(SEARCH(\"Concrete Base\", [@Project Scope])),\n      IF(OR([@2m x 2m square base]=\"YES\", [@Constructed within a 300mm vertical offset between URF and EPS]=\"YES\", [@Constructed within a 300mm vertical offset between EPS and Storage]=\"YES\"), 1, 0),\n      0),\n\n    -- URF Tank\n    IF(ISNUMBER(SEARCH(\"URF Tank\", [@Project Scope])),\n      IF([@What is the current status of the tank implementation for this URF?]=\"Completed\", 1, 0),\n      0),\n\n    -- EPS Tank\n    IF(ISNUMBER(SEARCH(\"EPS Tank\", [@Project Scope])),\n      IF([@What is the current status of the tank implementation for this EPS tank?]=\"Completed\", 1, 0),\n      0),\n\n    -- Balance Tank\n    IF(ISNUMBER(SEARCH(\"Balance Tank\", [@Project Scope])),\n      IF([@What is the current status of the tank implementation for this balance tank?]=\"Completed\", 1, 0),\n      0),\n\n    -- Storage Tank\n    IF(ISNUMBER(SEARCH(\"Storage Tank\", [@Project Scope])),\n      IF([@What is the current status of the tank implementation for the storage tank?]=\"Completed\", 1, 0),\n      0),\n\n    -- Standpipes\n    IF(ISNUMBER(SEARCH(\"Standpipes\", [@Project Scope])),\n      IFERROR([@1849634900001_implemented]/[@1849634900001_tobeimplemented], 0),\n      0),\n\n    -- Drainage (placeholder)\n    IF(ISNUMBER(SEARCH(\"Drainage\", [@Project Scope])),\n      0, -- replace with actual logic once defined\n      0),\n\n    -- Site Security\n    IF(ISNUMBER(SEARCH(\"Site Security\", [@Project Scope])),\n      (IF([@1849635500001_a]=\"Selected\", 1/3, 0) +\n       IF([@1849635500001_b]=\"Selected\", 1/3, 0) +\n       IF([@1849635500001_c]=\"Selected\", 1/3, 0)),\n      0)\n  )\n  /\n  -- Denominator: count of components in scope\n  SUMPRODUCT(\n    (ISNUMBER(SEARCH(\"Concrete Base\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"URF Tank\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"EPS Tank\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"Balance Tank\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"Storage Tank\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"Standpipes\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"Drainage\", [@Project Scope])))*1,\n    (ISNUMBER(SEARCH(\"Site Security\", [@Project Scope])))*1\n  ),\n\"\")",
