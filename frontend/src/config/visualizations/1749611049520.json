    {
      "id": "chart_ohs_equipment",
      "info": "Share of stations per option of OHS equipment (Available / Not used / Not available) on the latest monitoring. Stations monitored only via the Quick Monitoring form do not answer this question and fall into No information available.",
      "chart_type": "half_doughnut",
      "order": 10,
      "col_span": 8,
      "description": "The WAF pump station form carries a single OHS question with three options.",
      "config": {
        "title": "OHS Equipment"
      },
      "color_map": {
        "Available": "#64A73B",
