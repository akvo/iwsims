{
  "parent_form_id": 1749611049520,
  "slug": "pump-overview",
  "name": "Wastewater Pump Station",
  "description": "Overview dashboard for Wastewater Pump Station.",
  "fiscal_year_start_month": 1,
  "items": [
    {
      "id": "filters_main",
      "chart_type": "filter_bar",
      "order": 1,
      "col_span": 24,
      "items": [
        {
          "id": "filter_date",
          "chart_type": "filter_date",
          "order": 1,
          "label": "Monitoring Period",
          "date_question_names": {
            "monitoring": "inspection_date"
          }
        },
        {
          "id": "filter_administration",
          "chart_type": "filter_administration",
          "order": 2,
          "label": "Location"
        }
      ]
    },
    {
      "id": "kpi_total_pump_stations",
      "chart_type": "card",
      "order": 2,
      "col_span": 6,
      "label": "Total Pump Stations",
      "api": {
        "form_id": 1749611049520,
        "monitoring": "latest"
      }
    },
    {
      "id": "kpi_inspected_12_mo",
      "chart_type": "card",
      "order": 3,
      "col_span": 6,
      "label": "Inspected (12 mo)",
      "api": {
        "question_name": "inspection_date",
        "sum_by": "parent_id",
        "rolling_months": 12
      }
    },
    {
      "id": "kpi_operational",
      "chart_type": "metric_card",
      "order": 4,
      "col_span": 6,
      "label": "% Operational",
      "api": {
        "question_name": "station_status",
        "group_by": "option",
        "include_unanswered": true
      },
      "show_percentage": true,
      "target_group": "Operational"
    },
    {
      "id": "kpi_critical_issues",
      "chart_type": "card",
      "order": 5,
      "col_span": 6,
      "label": "Critical issues",
      "api": {
        "question_name": "station_status",
        "sum_by": "parent_id",
        "monitoring": "latest",
        "option_value": "Missing"
      }
    },
    {
      "id": "map_main",
      "chart_type": "map",
      "title": "Monitored Pump Station Sites",
      "order": 6,
      "col_span": 24,
      "height": 400,
      "source_form_id": 1749611049520,
      "filters": [
        {
          "type": "select",
          "key": "station_status",
          "label": "Operationality",
          "form_id": 1749611905372,
          "question_name": "station_status",
          "color_map": {
            "operational": "#64A73B",
            "overflowing": "#e6ab02",
            "blocked": "#e41a1c",
            "not_operational": "#666666",
            "_no_info": "#999999"
          }
        },
        {
          "type": "select",
          "key": "electrical_panel",
          "label": "Electrical issues",
          "form_id": 1749611905372,
          "question_name": "electrical_panel",
          "color_map": {
            "broken": "#e41a1c",
            "need_maintenance": "#e6ab02",
            "electrical_hazard": "#1b9e77",
            "satisfactory": "#7570b3",
            "_no_info": "#999999"
          }
        },
        {
          "type": "select",
          "key": "standby_facility",
          "label": "Standby facility",
          "form_id": 1749611905372,
          "formula": {
            "buckets": [
              {
                "value": "standby_available",
                "label": "Standby available",
                "all_of": [
                  {
                    "question_name": "num_pumps_standby",
                    "op": ">",
                    "value": 0
                  }
                ]
              },
              {
                "value": "no_standby",
                "label": "No standby",
                "all_of": [
                  {
                    "question_name": "num_pumps_standby",
                    "op": "<=",
                    "value": 0
                  }
                ]
              }
            ],
            "default": {
              "value": "_no_info",
              "label": "No information available"
            }
          },
          "color_map": {
            "standby_available": "#64A73B",
            "no_standby": "#e41a1c",
            "_no_info": "#999999"
          }
        },
        {
          "type": "toggle",
          "key": "monitored_last_year",
          "label": "Monitored last year",
          "default": true,
          "rolling_months": 12
        }
      ],
      "click_action": "popup",
      "click_url_template": "/control-center/data/1749611049520/monitoring/{data_id}"
    },
