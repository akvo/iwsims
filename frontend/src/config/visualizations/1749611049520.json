  "name": "Wastewater Pump Station",
  "description": "Overview dashboard for Wastewater Pump Station.",
  "fiscal_year_start_month": 1,
  "items": [
    {
      "id": "filters_main",
      "chart_type": "filter_bar",
      "order": 1,
      "col_span": 24,
      "items": [
        {
          "id": "filter_date",
          "chart_type": "filter_date",
          "order": 1,
          "label": "Monitoring Period",
          "date_question_names": {
            "monitoring": "inspection_date"
          }
        },
        {
          "id": "filter_administration",
          "chart_type": "filter_administration",
          "order": 2,
          "label": "Location"
        }
      ]
    },
    {
      "id": "kpi_total_pump_stations",
      "info": "Count registration records.",
      "chart_type": "card",
      "order": 2,
      "col_span": 6,
      "label": "Total Pump Stations",
      "api": {
        "monitoring": "latest",
        "ignore_date_filter": true
      }
    },
    {
      "id": "kpi_inspected_12_mo",
      "info": "count of Inspected.",
      "chart_type": "card",
      "order": 3,
      "col_span": 6,
      "label": "Inspected (12 mo)",
      "color": "#1890ff",
      "api": {
        "question_name": "inspection_date",
        "sum_by": "parent_id",
        "rolling_months": 12
      }
    },
    {
      "id": "kpi_operational",
      "info": "Station is Operational IF ANY:\n  • Pump Station Status =Operational} OR (\n  • Electrical Panel=Satisfactory AND\n  • Pump Station Lid = Covered AND\n  • Non return Valve = Operational AND\n  • Sluice valve = Operational AND\n  • Guardrails for Pump Station = Secured)\nCount = number of stations meeting any condition / total stations × 100.",
      "chart_type": "card",
      "order": 4,
      "col_span": 6,
      "label": "% Operational",
      "color": "#64A73B",
      "compute": "rules_kpi",
      "denominator_api": {
        "ignore_date_filter": true
      },
      "rules": [
        {
          "all_of": [
            {
              "question_name": "station_status",
              "op": "option_equals",
              "value": "operational"
            }
          ]
        },
        {
          "all_of": [
            {
              "question_name": "electrical_panel",
              "op": "option_equals",
              "value": "satisfactory"
            },
            {
              "question_name": "pump_station_lid",
              "op": "option_equals",
              "value": "covered"
            },
            {
              "question_name": "non_return_valve",
              "op": "option_equals",
              "value": "operational"
            },
            {
              "question_name": "sluice_valve",
              "op": "option_equals",
              "value": "operational"
            },
            {
              "question_name": "guardrails_pump_station",
              "op": "option_equals",
              "value": "secured"
            }
          ]
        }
      ]
    },
    {
      "id": "kpi_critical_issues",
      "info": "Station is CRITICAL (red) IF ANY:\n  • Pump Station Status ∈ {Not Operational, Overflowing, Blocked} OR (\n  • Electrical Panel ∈ {Broken, Electrical hazard} AND\n  • Pump Station Lid = Missing AND\n  • Non return Valve = Faulty AND\n  • Sluice valve = Faulty AND\n  • Guardrails for Pump Station = Missing AND  \n• OHS equipment = Not available)\nCount = number of stations meeting any condition.",
      "chart_type": "card",
      "order": 5,
      "col_span": 6,
      "label": "Critical issues",
      "color": "#e41a1c",
      "compute": "rules_kpi",
      "rules": [
        {
          "all_of": [
            {
              "question_name": "station_status",
              "op": "option_in",
              "values": ["not_operational", "overflowing", "blocked"]
            }
          ]
        },
        {
          "all_of": [
            {
              "question_name": "electrical_panel",
              "op": "option_in",
              "values": ["broken", "electrical_hazard"]
            },
            {
              "question_name": "pump_station_lid",
              "op": "option_equals",
              "value": "missing"
            },
            {
              "question_name": "non_return_valve",
              "op": "option_equals",
              "value": "faulty"
            },
            {
              "question_name": "sluice_valve",
              "op": "option_equals",
              "value": "faulty"
            },
            {
              "question_name": "guardrails_pump_station",
              "op": "option_equals",
              "value": "missing"
            },
            {
              "question_name": "ohs_equipment",
              "op": "option_equals",
              "value": "not_available"
            }
          ]
        }
      ]
    },
    {
      "id": "map_main",
      "chart_type": "map",
      "title": "Monitored Pump Station Sites",
      "order": 6,
      "col_span": 24,
      "height": 400,
      "filters": [
        {
          "type": "select",
          "key": "station_status",
          "label": "Operationality",
          "question_name": "station_status",
          "color_map": {
            "_no_info": "#999999"
          }
        },
        {
          "type": "select",
          "key": "electrical_panel",
          "label": "Electrical issues",
          "question_name": "electrical_panel",
          "color_map": {
            "_no_info": "#999999"
          }
        },
        {
          "type": "select",
          "key": "standby_facility",
          "label": "Standby facility",
          "formula": {
            "buckets": [
              {
                "value": "standby_available",
                "label": "Standby available",
                "all_of": [
                  {
                    "question_name": "num_pumps_standby",
                    "op": ">",
                    "value": 0
                  }
                ]
              },
              {
                "value": "no_standby",
                "label": "No standby",
                "all_of": [
                  {
                    "question_name": "num_pumps_standby",
                    "op": "<=",
                    "value": 0
                  }
                ]
              }
            ],
            "default": {
              "value": "_no_info",
              "label": "No information available"
            }
          },
          "color_map": {
            "standby_available": "#64A73B",
            "no_standby": "#e41a1c",
            "_no_info": "#999999"
          }
        },
        {
          "type": "toggle",
          "key": "monitored_last_year",
          "label": "Monitored last year",
          "default": true,
          "rolling_months": 12
        }
      ],
      "click_action": "popup"
    },
    {
      "id": "section_pumps_at_a_glance",
      "chart_type": "section_title",
      "order": 7,
      "col_span": 24,
      "text": "Pumps at a glance"
    },
    {
      "id": "chart_pumps_functioning",
      "info": "Histogram of stations by Number of pumps in operation on the latest monitoring submission. Stations reporting 0 pumps in operation have no pumping capacity at all.",
      "chart_type": "bar",
      "order": 8,
      "col_span": 8,
      "description": "Per DWS a station counts as operational only when the required duty pumps are online with a working standby. The monitoring form records the number in operation; the required duty count is not captured, so this shows the distribution only.",
      "config": {
        "title": "Pumps Functioning",
        "xAxisLabel": "Pumps in operation per station",
        "yAxisLabel": "# of stations",
        "grid": {
          "bottom": 72,
          "containLabel": true
        },
        "xAxis": {
          "nameGap": 44
        }
      },
      "api": {
        "question_name": "num_pumps_operational",
        "group_by": "parent_id",
        "monitoring": "latest"
      },
      "display": {
        "mode": "value_buckets",
        "buckets": [
          {
            "label": "0",
            "value": 0
          },
          {
            "label": "1",
            "value": 1
          },
          {
            "label": "2",
            "value": 2
          },
          {
            "label": "3",
            "value": 3
          },
          {
            "label": "4+",
            "min": 4
          }
        ]
      }
    },
    {
      "id": "chart_standby_availability",
      "info": "Standby available = Number of pumps standby > 0 on the latest monitoring. No standby = Number of pumps standby ≤ 0. Same rule as the Standby facility layer on the map above.",
      "chart_type": "doughnut",
      "order": 9,
      "col_span": 8,
      "description": "Standby pump availability is a High-priority indicator. Stations without an operable standby trigger a RED alert per DWS rules.",
      "config": {
        "title": "Standby Pump Availability"
      },
      "color_map": {
        "Standby available": "#64A73B",
        "No standby": "#e41a1c"
