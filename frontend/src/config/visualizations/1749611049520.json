    {
      "id": "chart_electrical_safety_issues",
      "info": "Stations whose latest monitoring reports a fault, missing equipment or hazard, per electrical component:\n  • Panel — Electrical panel ≠ Satisfactory (Broken / Need Maintenance / Electrical hazard)\n  • Amp meter — Amp meter ≠ Operational (Faulty / Maintenance in progress)\n  • Volt meter — Volt meter ≠ Operational\n  • Hour-run meter — Hour run meter ≠ Operational\n  • Lights — Lights ≠ Operational (Faulty / Not available)\n  • No back-up power — Power backup system = None\nEach bar is (stations answering the question) − (stations answering it OK), so every fault option counts without needing one call per option. Denominators differ per question because not every station answers every field.",
      "chart_type": "bar",
      "compute": "bucket_bar",
      "orientation": "horizontal",
      "order": 12,
      "col_span": 12,
      "description": "Counted per component rather than as a single \"Meters\" category: a station can fault on more than one meter, and summing separate per-meter counts would double-count it.",
      "config": {
        "title": "Electrical Safety Issues",
        "xAxisLabel": "# of stations reporting an issue",
        "grid": {
          "left": 120,
          "right": 32,
          "top": 32,
          "bottom": 72,
          "containLabel": false
        }
      },
      "buckets": [
        {
          "label": "Panel",
          "subtract": ["panel_total", "panel_ok"]
        },
        {
          "label": "Amp meter",
          "subtract": ["amp_total", "amp_ok"]
        },
        {
          "label": "Volt meter",
          "subtract": ["volt_total", "volt_ok"]
        },
        {
          "label": "Hour-run meter",
          "subtract": ["hour_total", "hour_ok"]
        },
        {
          "label": "Lights",
          "subtract": ["lights_total", "lights_ok"]
        },
        {
          "label": "No back-up power",
          "segment": "backup_none"
        }
      ],
      "segments": [
